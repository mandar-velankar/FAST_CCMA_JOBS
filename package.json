{
  "name": "F_TNDR_CAG_FAST_CCMA_JOBS",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^1",
    "@sap-cloud-sdk/http-client": "^3.15.0",
    "@sap/cds": "^8",
    "@sap/cds-odata-v2-adapter-proxy": "^1.9.21",
    "@sap/xssec": "^4",
    "axios": "^0.21.1",
    "express": "^4",
    "handlebars": "^4.7.8",
    "moment": "^2.30.1",
    "qs": "^6.10.1",
    "cfenv": "^1.2.4",
    "ramda": "^0.27.0",
    "cron": "^1.8.2",
    "cron-es6": "^1.0.3",
    "cron-job-manager": "^2.2.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^7",
    "@sap/eslint-plugin-cds": "^3",
    "eslint": "^9"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch:hybrid": "cds bind --exec npm run watch --profile hybrid",
    "watch:mv": "cds bind --exec npm run watch --profile mandar",
    "build:cds": "cds build --production",
    "undeploy": "cf undeploy F_TNDR_CAG_FAST_CCMA_JOBS --delete-services --delete-service-keys --delete-service-brokers",
    "deploy:sql": "cds deploy --to sqlite",
    "deploy:hana:hybrid": "cds bind --exec cds deploy --to hana --profile hybrid",
    "deploy:hana:mv": "cds bind --exec cds deploy --to hana --profile mandar",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "cds": {
    "requires": {
      "auth": "xsuaa",
      "html5-runtime": true,
      "FASTBACKEND_API": {
        "kind": "rest",
        "credentials": {
          "destination": "FAST_API_OAUTH"
        }
      }
    }
  }
}
